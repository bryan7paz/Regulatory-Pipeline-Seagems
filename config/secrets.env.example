# ════════════════════════════════════════════════════════════════
#  Credenciais — copie para config/secrets.env e preencha
# ════════════════════════════════════════════════════════════════

# ── Banco de dados ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://regulatory:regulatory@localhost:5432/regulatory

# ── API Security ────────────────────────────────────────────────
# Chave única para autenticação da API (deixe vazio = API aberta)
API_KEY=

# Múltiplas chaves separadas por vírgula (opcional)
# API_KEYS=chave1,chave2,chave3

# ── LLM (preencha ao menos um) ─────────────────────────────────
# Groq (gratuito, rápido) — https://console.groq.com
GROQ_API_KEY=

# NVIDIA NIM (gratuito) — https://build.nvidia.com
NVIDIA_API_KEY=

# OpenRouter (modelos gratuitos) — https://openrouter.ai
OPENROUTER_API_KEY=

# Google Gemini (gratuito) — https://aistudio.google.com
GOOGLE_API_KEY=

# Cerebras (gratuito) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral (gratuito tier) — https://console.mistral.ai
MISTRAL_API_KEY=

# OpenAI (pago) — https://platform.openai.com
# OPENAI_API_KEY=

# ── IMODOCS (opcional) ─────────────────────────────────────────
IMODOCS_USER=
IMODOCS_PASSWORD=

# ── Scheduler ───────────────────────────────────────────────────
SCHEDULE_HOUR=06
SCHEDULE_TIMEZONE=America/Sao_Paulo
